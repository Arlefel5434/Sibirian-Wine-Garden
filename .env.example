APP_NAME="Siberian Wine Garden"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888
APP_TRUSTED_HOSTS=localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

AUTH_GUARD=api
BCRYPT_ROUNDS=12

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_REFRESH_IAT=false
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

REFRESH_TOKEN_TTL=20160
REFRESH_TOKEN_COOKIE=wine_garden_refresh
REFRESH_TOKEN_PATH=/api/auth
REFRESH_TOKEN_DOMAIN=null
REFRESH_TOKEN_SECURE_COOKIE=false
REFRESH_TOKEN_SAME_SITE=strict

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wine_garden
DB_USERNAME=wine
DB_PASSWORD=wine_local_password
DB_SSLMODE=prefer

CACHE_STORE=redis
CACHE_LIMITER_STORE=database
CACHE_PREFIX=wine_garden_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_CACHE_TIMEOUT=0.25
REDIS_CACHE_READ_TIMEOUT=0.5
REDIS_CACHE_MAX_RETRIES=0

CONTENT_CACHE_ENABLED=true
CONTENT_CACHE_TTL=1800
CONTENT_CACHE_LOCK_SECONDS=10
CONTENT_CACHE_LOCK_WAIT_SECONDS=2

QUEUE_CONNECTION=rabbitmq
QUEUE_FAILED_DRIVER=database-uuids

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wine
RABBITMQ_PASSWORD=wine_local_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=orders.process
RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_TIMEOUT=5
RABBITMQ_WRITE_TIMEOUT=5
RABBITMQ_CHANNEL_RPC_TIMEOUT=5
RABBITMQ_PUBLISHER_CONFIRM_TIMEOUT=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
